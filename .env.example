# Skopiuj do .env. Plik .env nie trafia do repozytorium.

APP_ENVIRONMENT=dev

# Klucz podpisujacy ciasteczko sesji.
# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=zmien-mnie-na-losowy-ciag

# Uzywane przez docker compose
POSTGRES_USER=secforum
POSTGRES_PASSWORD=secforum_local_dev
POSTGRES_DB=secforum
WEB_PORT=43117
MAILHOG_UI_PORT=8025

# Linki w mailach (reset hasla)
APP_PUBLIC_BASE_URL=http://localhost:43117
APP_SMTP_FROM=noreply@folium.local
