# Skopiuj do .env i uzupelnij. Plik .env nie trafia do repozytorium.
# W Azure te same klucze trafia do App Settings / Key Vault (L4-L6).

# local | dev | test | prod
APP_ENVIRONMENT=dev

# Wygeneruj np.: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=zmien-mnie-na-losowy-ciag

# Lokalnie bez Dockera mozna zostawic SQLite:
# APP_DATABASE_URL=sqlite:///./data/secforum.db
APP_DATABASE_URL=postgresql+psycopg://secforum:secforum_local_dev@db:5432/secforum

# true dopiero, gdy ruch idzie po HTTPS (certyfikat na warstwie brzegowej)
APP_COOKIE_SECURE=false

APP_SESSION_IDLE_TIMEOUT_MINUTES=30
APP_SESSION_ABSOLUTE_TTL_MINUTES=720
APP_LOG_LEVEL=INFO

# Uzywane przez docker compose
POSTGRES_USER=secforum
POSTGRES_PASSWORD=secforum_local_dev
POSTGRES_DB=secforum
WEB_PORT=43117
